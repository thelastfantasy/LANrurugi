# Rust
/target/
**/*.rs.bk
*.pdb

# Node / frontend
node_modules/
apps/frontend/dist/
apps/frontend/node_modules/
apps/frontend/.vite/
# pnpm's local package store — normally lives outside the repo (~/.local/share/pnpm/store), but
# running `pnpm install` inside a container whose store-dir config doesn't match the host's
# creates a fallback store here instead (hit during 003-ui-test-automation's implementation).
/.pnpm-store/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Local env / secrets
.env
.env.*
!.env.example

# mise local state (installs live outside the repo; this is just local override files)
.mise.local.toml

# Scratch fixtures (images, archives, etc.) for manual local testing — never committed
testdata/
.convert-out/

# Local runtime data — bind-mount target for `docker run -v`/`podman run -v` (library archives,
# thumbnails, temp cache, logs, sideloaded custom plugins). Never committed; this is real user
# library content, not source.
/data/

# 003-ui-test-automation: Playwright's own run artifacts (reports, traces, screenshots) and each
# e2e worker's own throwaway library/thumb/temp directories (tests/e2e/fixtures.ts) — generated by
# every `test:e2e` run, never committed. `test-fixtures/archives/` itself (checked-in fixture
# binaries) is intentionally NOT covered by this pattern.
apps/frontend/playwright-report/
apps/frontend/test-results/
apps/frontend/blob-report/
/.e2e-worker-*/
# redis-server's default RDB persistence file — a stray one in the repo root previously caused
# every "fresh" test Redis instance to silently reload the same stale snapshot regardless of port
# (each worker's redis-server now runs with `--save ""` and its own isolated CWD to prevent this,
# but this stays as a defense-in-depth guard against ever committing one by accident).
dump.rdb
# The backend's own default `--log-directory` (`./log`) — real runtime logs from manually running
# `lanrurugi-server` in the repo root during local debugging, never committed.
/log/
