# Values for compose.yaml. Copy to `.env` next to it and fill in; `.env` is gitignored.
#
# The sink needs no Cloudflare API token — `TUNNEL_TOKEN` is the tunnel's own run token, created
# when the tunnel is created in the Zero Trust dashboard.

# Alphanumeric only: it goes inside a Redis URL, so `@ : / ?` would break parsing.
REDIS_PASSWORD=

# Directory that survives container recreates. On TrueNAS point this at a dataset.
REDIS_DATA=./data

# Zero Trust → Networks → Tunnels → your tunnel → Install connector → the token starting `eyJ...`
TUNNEL_TOKEN=

# Days a per-day key is kept. The sink only ever reports "how many / where / which version", so
# this is about Redis disk, not history: raising it costs bytes, not a migration.
RETENTION_DAYS=400

# Pin a release instead of `latest` so a redeploy cannot change the sink's behavior unasked.
#LANRURUGI_IMAGE=ghcr.io/thelastfantasy/lanrurugi:latest
