# Values for compose.yaml. Copy to `.env` next to it and fill in; `.env` is gitignored.

# Alphanumeric only: it goes inside a Redis URL, so `@ : / ?` would break parsing.
REDIS_PASSWORD=

# Directory that survives container recreates. On TrueNAS point this at a dataset.
REDIS_DATA=./data

# Image built from this repository (the released one predates the `telemetry-ingest` subcommand).
# Keep the `localhost/` prefix: without it docker treats the name as a registry image and tries to
# pull it. Built with `telemetry/Dockerfile.ingest`, which is ~255 MB instead of the full image.
LANRURUGI_IMAGE=localhost/lanrurugi-telemetry:local

# Days a per-day key is kept. The sink only ever reports "how many / where / which version", so
# this is about Redis disk, not history: raising it costs bytes, not a migration.
RETENTION_DAYS=400

# Bearer token for the read side (`GET /stats` JSON, `GET /` HTML dashboard). Empty — the default —
# means neither route exists and the service stays write-only. Generate one with:
#   openssl rand -hex 32
STATS_TOKEN=

# Only used by the commented-out `cloudflared` service in compose.yaml.
#TUNNEL_TOKEN=
