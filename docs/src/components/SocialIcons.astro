---
// Top-bar links: the GitHub icon (the same one the homepage, Swagger UI and SDK bars carry) and the
// documentation version picker. Only links that resolve are listed — there is no public demo,
// Discord or upstream-project link on purpose.
import fs from 'node:fs'
import path from 'node:path'

import { Icon } from '@astrojs/starlight/components'
import config from 'virtual:starlight/user-config'

type Locale = 'zh' | 'en'
const locale: Locale = Astro.currentLocale === 'en' ? 'en' : 'zh'

const LINKS: Record<Locale, { label: string; href: string; external: boolean }[]> = {
  zh: [{ label: 'GitHub', href: 'https://github.com/thelastfantasy/LANrurugi', external: true }],
  en: [{ label: 'GitHub', href: 'https://github.com/thelastfantasy/LANrurugi', external: true }],
}

// The version badge reads the workspace's own `Cargo.toml`, so it cannot drift from what was built:
// the docs ship in the same tree as the server, and every release builds both from one tag. A
// prerelease (`1.0.0-beta.1`) is shown as such and links to its own GitHub release.
//
// This replaced an inert `<select>` with a single "current version" option: a picker whose only
// choice is "the one you are reading" is a control that promises something it cannot do. When
// versioned doc trees actually exist, this is where the picker comes back.
// `import.meta.url` is the reliable path while Astro compiles this file; `process.cwd()` (the
// `docs/` package root) is the fallback, and `dev` the honest answer when neither resolves.
let buildVersion = 'dev'
for (const candidate of [
  path.resolve(new URL('../../../Cargo.toml', import.meta.url).pathname),
  path.resolve(process.cwd(), '../Cargo.toml'),
]) {
  try {
    const manifest = fs.readFileSync(candidate, 'utf8')
    const found = /^version = "(.*)"/m.exec(manifest)?.[1]
    if (found) {
      buildVersion = found
      break
    }
  } catch {
    // Try the next candidate.
  }
}
const isPrerelease = buildVersion.includes('-')
const releaseHref = `https://github.com/thelastfantasy/LANrurugi/releases/tag/v${buildVersion}`

// Fail loudly at build time if a configured `social` entry is not represented here, so adding one in
// `astro.config.mjs` and forgetting this component cannot silently drop it.
const configured = (config.social ?? []).map((entry) => entry.href)
const rendered = new Set(LINKS[locale].map((link) => link.href))
const dropped = configured.filter((href) => !rendered.has(href))
if (dropped.length > 0) {
  throw new Error(
    `SocialIcons override: astro.config.mjs declares ${dropped.join(', ')} but this component does ` +
      `not render it. Either add it to LINKS or drop it from the config — a configured link that ` +
      `never appears is worse than no config entry at all.`,
  )
}

const versionLabel = locale === 'zh' ? '文档版本' : 'Documentation version'
---

<nav class="nav-links" aria-label={locale === 'zh' ? '外部链接' : 'External links'}>
  {
    LINKS[locale].map((link) => (
      <a
        href={link.href}
        class="nav-links__item"
        rel={link.external ? 'noreferrer' : undefined}
        title={link.label}
        aria-label={link.label}
      >
        <Icon name="github" size="1.35rem" />
      </a>
    ))
  }
  <a
    class:list={['nav-links__version', isPrerelease && 'nav-links__version--beta']}
    href={releaseHref}
    rel="noreferrer"
    title={`${versionLabel}: v${buildVersion}`}
  >
    v{buildVersion}
  </a>
</nav>

<style>
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--sl-text-sm);
  }

  .nav-links__item {
    display: inline-flex;
    padding: 0.25rem;
    color: var(--sl-color-gray-2);
  }

  .nav-links__item:hover {
    color: var(--sl-color-white);
  }

  .nav-links__item :global(svg) {
    transition: transform 300ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .nav-links__item:hover :global(svg) {
    transform: rotate(-14deg) scale(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links__item :global(svg) {
      transition: none;
    }
  }

  /* The reference site puts its version picker above the sidebar; Starlight keeps its global
     pickers (theme, language) in this bar, so the version belongs beside them rather than in a
     second, separately-positioned control. */
  .nav-links__version {
    display: inline-flex;
    align-items: center;
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links__version:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  /* A prerelease is not what most readers should install, so it is marked rather than looking like
     any other version. */
  .nav-links__version--beta {
    border-color: var(--lr-beta, #c79121);
    color: var(--lr-beta, #c79121);
  }
</style>
