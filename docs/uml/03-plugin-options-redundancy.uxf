<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>

  <!-- 标题 / 发现说明 -->
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>60</x>
      <y>40</y>
      <w>980</w>
      <h>100</h>
    </coordinates>
    <panel_attributes>图 3/3 —— 冗余发现：DomainRule 被独立定义了三次
同样的四个字段（pattern / max_concurrent / max_bytes_per_sec / [description]）在三个 crate 里
各自手写了一份，没有共享 trait 或 newtype——只靠约定和一个往返测试（round-trip test，
该模块自己的文档注释里写明）保持同步，不是靠类型系统。给其中一份加字段而漏掉另外
两份，会在运行时悄悄破坏 download_manager::settings::merge 的合并逻辑。
bg=#fff2cc</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- 第 1 份：lanrurugi_plugin::protocol::DomainRule -->
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>60</x>
      <y>200</y>
      <w>280</w>
      <h>170</h>
    </coordinates>
    <panel_attributes>&lt;&lt;第 1/3 份&gt;&gt;
lanrurugi_plugin::protocol::
DomainRule
--
pattern: Option&lt;String&gt;
max_concurrent: Option&lt;u32&gt;
max_bytes_per_sec: Option&lt;u64&gt;
description: Option&lt;String&gt;
--
插件自己声明的默认规则，
从 Deno 插件的 pluginOptions()
导出读取。
bg=#ffe6cc</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- 第 2 份：download_manager::domain_rules::DomainRule -->
  <element>
