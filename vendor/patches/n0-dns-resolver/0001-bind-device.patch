 use super::{pool::ConnPool, query};
 
+/// LANrurugi fork (022): the interface DNS queries leave through, if any. Set by the sharing engine
+/// next to netwatch's and iroh-relay's, so name lookups for a pinned endpoint stay on the tunnel too.
+/// A nameserver on loopback (a local stub such as systemd-resolved) is never pinned: the query does
+/// not leave the host, and binding it to another interface would only make it fail.
+static BIND_DEVICE: std::sync::RwLock<Option<std::ffi::CString>> = std::sync::RwLock::new(None);
+
+/// Pins the sockets this crate creates to `device`. An embedded NUL is ignored, since an interface
+/// name cannot contain one.
+pub fn set_bind_device(device: Option<&str>) {
+    let next = device
+        .filter(|s| !s.is_empty())
+        .and_then(|s| std::ffi::CString::new(s).ok());
+    *BIND_DEVICE.write().unwrap_or_else(|e| e.into_inner()) = next;
+}
+
+fn bind_device() -> Option<std::ffi::CString> {
+    BIND_DEVICE.read().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+fn bind_device_for(addr: SocketAddr) -> Option<std::ffi::CString> {
+    if addr.ip().is_loopback() {
+        return None;
+    }
+    bind_device()
+}
+
+#[cfg(target_os = "linux")]
+fn pin_socket(socket: socket2::SockRef<'_>, device: &std::ffi::CStr) -> io::Result<()> {
+    socket.bind_device(Some(device.to_bytes()))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn pin_socket(_socket: socket2::SockRef<'_>, _device: &std::ffi::CStr) -> io::Result<()> {
+    Ok(())
+}
+
+/// `TcpStream::connect`, with the socket pinned first when an interface is set.
+async fn tcp_connect(addr: SocketAddr) -> io::Result<tokio::net::TcpStream> {
+    let Some(device) = bind_device_for(addr) else {
+        return tokio::net::TcpStream::connect(addr).await;
+    };
+    let socket = if addr.is_ipv6() {
+        tokio::net::TcpSocket::new_v6()?
+    } else {
+        tokio::net::TcpSocket::new_v4()?
+    };
+    pin_socket(socket2::SockRef::from(&socket), &device)?;
+    socket.connect(addr).await
+}
+
