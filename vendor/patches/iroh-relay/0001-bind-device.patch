+#[cfg(not(wasm_browser))]
+/// The interface the relay client's TCP sockets are pinned to, if any (LANrurugi fork, 022).
+/// Set once per endpoint bind by the sharing engine; `None` leaves sockets on the kernel's routing.
+static BIND_DEVICE: std::sync::RwLock<Option<std::ffi::CString>> = std::sync::RwLock::new(None);
+
+/// Pins this client's TCP sockets to `device`. An embedded NUL is ignored — interface names cannot
+/// contain one.
+#[cfg(not(wasm_browser))]
+pub fn set_bind_device(device: Option<&str>) {
+    let next = device
+        .filter(|s| !s.is_empty())
+        .and_then(|s| std::ffi::CString::new(s).ok());
+    *BIND_DEVICE.write().unwrap_or_else(|e| e.into_inner()) = next;
+}
+
+#[cfg(not(wasm_browser))]
+pub(crate) fn bind_device() -> Option<std::ffi::CString> {
+    BIND_DEVICE
+        .read()
+        .unwrap_or_else(|e| e.into_inner())
+        .clone()
+}
