+/// LANrurugi fork (022): pin the relay's TCP socket to the interface the sharing node is bound to.
+/// `TcpStream::connect` offers no way to set a socket option before connecting, so with an interface
+/// configured the socket is built here, pinned with `SO_BINDTODEVICE`, and connected non-blockingly.
+async fn connect_bound(addr: std::net::SocketAddr) -> std::io::Result<TcpStream> {
+    let Some(name) = super::bind_device() else {
+        return TcpStream::connect(addr).await;
+    };
+    let domain = match addr {
+        std::net::SocketAddr::V4(_) => socket2::Domain::IPV4,
+        std::net::SocketAddr::V6(_) => socket2::Domain::IPV6,
+    };
+    let socket = socket2::Socket::new(domain, socket2::Type::STREAM, Some(socket2::Protocol::TCP))?;
+    #[cfg(target_os = "linux")]
+    {
+        use std::os::fd::AsRawFd;
+        let ret = unsafe {
+            setsockopt_bind_device(
+                socket.as_raw_fd(),
+                name.as_ptr().cast(),
+                name.as_bytes_with_nul().len(),
+            )
+        };
+        if ret != 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+    }
+    socket.set_nonblocking(true)?;
+    match socket.connect(&addr.into()) {
+        Ok(()) => {}
+        Err(e) if e.raw_os_error() == Some(expected_in_progress()) => {}
+        Err(e) => return Err(e),
+    }
+    let std_stream: std::net::TcpStream = socket.into();
+    let stream = TcpStream::from_std(std_stream)?;
+    stream.writable().await?;
+    if let Some(err) = stream.take_error()? {
+        return Err(err);
+    }
+    Ok(stream)
+}
+
+/// `EINPROGRESS` as this platform numbers it (Linux 115; macOS and the BSDs 36). Spelled out
+/// rather than imported so the fork keeps no `libc` dependency.
+const fn expected_in_progress() -> i32 {
+    if cfg!(target_os = "linux") { 115 } else { 36 }
+}
+
+/// `SOL_SOCKET` (1) / `SO_BINDTODEVICE` (25) are stable on every Linux target this ships for; the
+/// FFI declaration keeps `libc` out of the vendored crate's dependency list for one call.
+#[cfg(target_os = "linux")]
+unsafe fn setsockopt_bind_device(
+    fd: std::os::fd::RawFd,
+    value: *const std::ffi::c_char,
+    len: usize,
+) -> i32 {
+    unsafe extern "C" {
+        fn setsockopt(
+            sockfd: i32,
+            level: i32,
+            optname: i32,
+            optval: *const std::ffi::c_void,
+            optlen: u32,
+        ) -> i32;
+    }
+    unsafe { setsockopt(fd, 1, 25, value.cast(), len as u32) }
+}
