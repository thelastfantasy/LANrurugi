# syntax=docker/dockerfile:1
#
# Local full-stack dev image — NOT the runtime image (see `Dockerfile` for that; this one is
# never deployed, only ever built and run locally via `compose.dev.yaml`). Bundles Redis +
# a compiled `lanrurugi-server` + a Node/pnpm frontend dev environment into one container, so
# `podman compose -f compose.dev.yaml up -d` is the only thing needed for a full local loop with
# live frontend hot-reload — kept entirely separate from the production `Dockerfile` so that one
# stays free of dev-only tooling (Node/pnpm/vite) and dev-mode entrypoint branching it has no
# other use for.
#
# The frontend's *source* is bind-mounted in at container-run time by `compose.dev.yaml` (not
# baked in here) — that's what makes edits on the host show up live via Vite's own file watcher.
# `node_modules` (both this package's own and the workspace root's hoisted copy) IS baked in here
# via `pnpm install`, for a fast, lockfile-deterministic container start rather than reinstalling
# on every `up`; `compose.dev.yaml`'s own volumes "poke a hole" back through the source bind mount
# so it isn't shadowed. The backend is a normal compiled binary (rebuilt only when this image is
# rebuilt) — this doesn't attempt Rust hot-reload, only the frontend, matching what was actually
# asked for.

ARG RUST_VERSION=1.97.1
ARG NODE_VERSION=24.18.0
ARG PNPM_VERSION=11.10.0
ARG REDIS_VERSION=7.4.9
ARG DENO_VERSION=2.9.1

FROM rust:${RUST_VERSION}-slim-bookworm AS rust-builder
ARG LANRURUGI_GIT_SHA=unknown
WORKDIR /build
ENV LANRURUGI_GIT_SHA=${LANRURUGI_GIT_SHA}
# Same libarchive2-sys/libwebp-sys build deps as the production `Dockerfile`'s own `rust-builder`
# stage — see that file's doc comment for the full rationale.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        make \
        gcc \
        g++ \
        cmake \
        libclang-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libzstd-dev \
        liblz4-dev \
        libxml2-dev \
        libacl1-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Cache mounts persist cargo registry + incremental build artifacts across
# rebuilds, but their contents are NOT part of the image layer — the binary
# must be copied out explicitly for the `COPY --from` in the runtime stage
# to find it.
RUN --mount=type=cache,id=lrr-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=lrr-cargo-target,target=/build/target \
    cargo build --release -p lanrurugi-server -p lanrurugi-gpu-worker && \
    cp /build/target/release/lanrurugi-server /build/lanrurugi-server && \
    cp /build/target/release/lanrurugi-gpu-worker /build/lanrurugi-gpu-worker

# Frontend *dependencies* only — not a build. `pnpm install` alone (no `pnpm run build`) gives
# this stage's `node_modules` (root workspace + `apps/frontend`'s own) to copy into `runtime`;
# `vite dev` serves straight from the bind-mounted source at container-run time instead of any
# prebuilt `dist/`.
FROM node:${NODE_VERSION}-slim AS frontend-deps
ARG PNPM_VERSION
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/frontend/package.json apps/frontend/package.json
RUN pnpm install --frozen-lockfile --filter lanrurugi-frontend

# Same rationale as the production `Dockerfile`'s own `redis-bin` stage: the official image's
# `-bookworm` (glibc) variant, pinned to the exact version this project's Redis data is already
# written with.
FROM docker.io/library/redis:${REDIS_VERSION}-bookworm AS redis-bin

# Same rationale as the production `Dockerfile`'s own `deno-bin` stage — plugins (Deno-executed
# `.ts` files) can't run at all without this; missing from this file's first draft entirely
# (verified the hard way — plugin calls would have failed outright with no `deno` binary present).
FROM docker.io/denoland/deno:bin-${DENO_VERSION} AS deno-bin

# GPU EP integration (issue #103): base is NVIDIA's official CUDA13 runtime image, not
# `debian:bookworm-slim`, so this dev container can actually load CUDA/cuDNN — no Debian-based
# NVIDIA CUDA image exists at all (only Ubuntu/RHEL UBI/Rocky/Oracle Linux/openSUSE; verified
# against Docker Hub's real tag listing), so this same distro swap is what production's own GPU
# Dockerfile needs too, not a dev-only shortcut. `cudnn-runtime` (not plain `cuda-runtime`) because
# ORT's CUDA EP needs cuDNN for convolution ops — see `cuda.rs`'s own `CUDNN_DYLIBS` list.
FROM docker.io/nvidia/cuda:13.3.1-cudnn-runtime-ubuntu24.04 AS runtime
# Ubuntu 24.04 (noble) renamed several t64-transition packages — verified against a real
# `ubuntu:24.04` container's own `apt-cache`/`apt list`, not assumed: only `libssl3` actually
# changed (-> `libssl3t64`) of everything in this list; `libstdc++6` and the rest are unchanged
# (a first check of `libstdc++6` looked "missing" but was a broken `+`-unescaped regex in the
# verification script, not a real absence — confirmed present and already preinstalled by base).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fonts-noto-cjk \
        libstdc++6 \
        zlib1g \
        libbz2-1.0 \
        liblzma5 \
        libzstd1 \
        liblz4-1 \
        libxml2 \
        libacl1 \
        libssl3t64 \
        geoipupdate \
        unzip \
        pciutils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=redis-bin /usr/local/bin/redis-server /usr/local/bin/redis-cli /usr/local/bin/
COPY --from=deno-bin /deno /usr/local/bin/deno
COPY --from=rust-builder /build/lanrurugi-server /usr/local/bin/lanrurugi-server
# GPU EP integration plan v9 (issue #103): `lanrurugi-gpu-worker` is a separate subprocess binary
# `lanrurugi-server` spawns next to itself (`gpu_worker_client::GpuWorkerClient::worker_binary_path`
# looks for it in the same directory as `std::env::current_exe()`) — same `/usr/local/bin` this
# stage already puts `lanrurugi-server` in, no separate location to configure.
COPY --from=rust-builder /build/lanrurugi-gpu-worker /usr/local/bin/lanrurugi-gpu-worker

# GPU EP integration plan v9 (issue #103): TWO separate ONNX Runtime builds are needed now, not
# one — `lanrurugi-server` itself no longer touches CUDA at all (every CUDA session moved into the
# `lanrurugi-gpu-worker` subprocess below), but it still needs a *CPU* `libonnxruntime.so` for
# `lanrurugi-recommend`'s embedding model (a separate, unrelated `ort` integration, pinned to a
# different `ort` version — `2.0.0-rc.12` vs this project's `2.0.0-rc.13` elsewhere — see that
# crate's own `Cargo.toml`). `ort`'s `load-dynamic` feature defaults to a bare `dlopen
# ("libonnxruntime.so")` (no `ORT_DYLIB_PATH` set) that walks the standard system library search
# path — if both builds installed a same-named `.so` into the same directory, whichever copied
# last would silently win for *both* processes, handing `lanrurugi-server` a GPU-flavored library
# it has no CUDA use for and (worse) no guarantee the copy order stays that way across a future
# edit. Each build instead lives in its own directory, and each binary gets its own explicit
# `ORT_DYLIB_PATH` (see `ENV` block near the bottom of this file) — no reliance on whichever
# happened to be `ldconfig`'d most recently.
#
# CPU build: same official GitHub release tarball layout `lanrurugi-recommend` has always used.
ARG ORT_VERSION=1.27.0
RUN mkdir -p /usr/local/lib/ort-cpu \
    && curl -fsSL -o /tmp/ort-cpu.tgz https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz \
    && tar xzf /tmp/ort-cpu.tgz -C /tmp onnxruntime-linux-x64-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} \
    && cp /tmp/onnxruntime-linux-x64-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} /usr/local/lib/ort-cpu/ \
    && ln -sf libonnxruntime.so.${ORT_VERSION} /usr/local/lib/ort-cpu/libonnxruntime.so.1 \
    && ln -sf libonnxruntime.so.1 /usr/local/lib/ort-cpu/libonnxruntime.so \
    && rm -rf /tmp/ort-cpu.tgz /tmp/onnxruntime-linux-x64-${ORT_VERSION}
#
# GPU (CUDA13) build, for `lanrurugi-gpu-worker` only — Microsoft's official `gpu_cuda13` release
# asset, same pinned `ORT_VERSION`. `gpu_cuda13` specifically (not `gpu_cuda12`, which this same
# release also publishes) because RTX 5060 is Blackwell (`sm_120`) — frame-forge's own
# `gpu_compat.rs` module comment documents that the standard CUDA12 ORT asset has no SASS/PTX
# kernels for `sm_120` at all, only the CUDA13 asset does.
#
# This is a genuine dynamic-`.so` build (`libonnxruntime.so.${ORT_VERSION}` + symlinks, same shape
# as the CPU build above) — verified by actually downloading and listing this exact tarball's
# contents before writing this step, not assumed. This matters because it's NOT true of every
# CUDA-capable ORT source: pyke's own CDN-hosted `cuda13,tensorrt,nvrtx` build turned out, on
# actual extraction, to ship a *static* `libonnxruntime.a` instead of a shared `.so` —
# fundamentally incompatible with `ort`'s `load-dynamic` feature this whole project is built around
# (that feature `dlopen`s a single `.so` at `ORT_DYLIB_PATH`; a `.a` needs compile-time static
# linking instead, a different architecture entirely). Microsoft's official asset avoids that
# mismatch, so this project doesn't need to move away from `load-dynamic`.
#
# `libonnxruntime_providers_cuda.so`/`_shared.so` also extracted alongside the core `.so` — ORT's
# CUDA EP is a separate plugin the core library dlopens by name from the same directory at runtime
# when a session actually registers CUDA (standard ORT provider-plugin architecture), not something
# baked into the core `.so` itself. `_tensorrt.so` (also in this tarball) is NOT extracted — this
# phase is explicitly CUDA-only, TensorRT is out of scope.
RUN mkdir -p /usr/local/lib/ort-gpu \
    && curl -fsSL -o /tmp/ort-gpu.tgz https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}.tgz \
    && tar xzf /tmp/ort-gpu.tgz -C /tmp \
        onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} \
        onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime_providers_cuda.so \
        onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime_providers_shared.so \
    && cp /tmp/onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} /usr/local/lib/ort-gpu/ \
    && cp /tmp/onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime_providers_cuda.so /usr/local/lib/ort-gpu/ \
    && cp /tmp/onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION}/lib/libonnxruntime_providers_shared.so /usr/local/lib/ort-gpu/ \
    && ln -sf libonnxruntime.so.${ORT_VERSION} /usr/local/lib/ort-gpu/libonnxruntime.so.1 \
    && ln -sf libonnxruntime.so.1 /usr/local/lib/ort-gpu/libonnxruntime.so \
    && rm -rf /tmp/ort-gpu.tgz /tmp/onnxruntime-linux-x64-gpu_cuda13-${ORT_VERSION} \
    && ldconfig

# OpenVINO build, for `lanrurugi-gpu-worker` only, Intel GPUs (Arc etc.) — see `gpu_worker_client`'s
# own module doc for why this exists at all (issue #103's OpenVINO-EP-hang finding: Microsoft's
# official Linux ORT release tarballs — the CPU and CUDA13 ones fetched above — have NEVER had
# OpenVINO provider code compiled in at all, not even as a missing-dependency gap; registering
# `OpenVINOExecutionProvider` against either one is undefined behavior that hangs indefinitely
# inside `session.run()` rather than failing cleanly, verified against a real prior incident this
# project's own history recorded). Intel's own `onnxruntime-openvino` PyPI wheel is the only
# official prebuilt artifact anywhere that actually contains `libonnxruntime_providers_openvino.so`
# — verified by downloading and listing this exact wheel's contents before writing this step, same
# discipline as the CUDA13 tarball comment above. A `.whl` is just a zip file; `unzip` (installed
# above) extracts it directly, no `pip`/Python environment needed at all — this project never runs
# Python, only reuses PyPI as a distribution channel for Intel's prebuilt `.so` files.
#
# `cp312` tag is arbitrary — every cp3xx variant of this wheel ships byte-identical native `.so`
# files; the Python version only affects `onnxruntime_pybind11_state*.so` (the pybind11 extension
# module), which is deliberately NOT extracted below since this project only ever uses the C API.
# Pinned URL + SHA-256, not resolved against PyPI's JSON API at build time — same reasoning as
# `ORT_VERSION` being an explicit `ARG` rather than "whatever's latest": an upstream wheel bump is
# a reviewed code change here, not something that should silently change on the next `docker build`.
ARG ORT_OPENVINO_VERSION=1.24.1
ARG ORT_OPENVINO_WHEEL_URL=https://files.pythonhosted.org/packages/50/cf/17ba72de2df0fcba349937d2788f154397bbc2d1a2d67772a97e26f6bc5f/onnxruntime_openvino-1.24.1-cp312-cp312-manylinux_2_28_x86_64.whl
ARG ORT_OPENVINO_WHEEL_SHA256=d617fac2f59a6ab5ea59a788c3e1592240a129642519aaeaa774761dfe35150e
RUN mkdir -p /usr/local/lib/ort-openvino \
    && curl -fsSL -o /tmp/ort-openvino.whl "${ORT_OPENVINO_WHEEL_URL}" \
    && echo "${ORT_OPENVINO_WHEEL_SHA256}  /tmp/ort-openvino.whl" | sha256sum -c - \
    && unzip -q /tmp/ort-openvino.whl -d /tmp/ort-openvino-extract "onnxruntime/capi/*.so*" \
    && rm -f /tmp/ort-openvino-extract/onnxruntime/capi/onnxruntime_pybind11_state*.so \
    && cp /tmp/ort-openvino-extract/onnxruntime/capi/*.so* /usr/local/lib/ort-openvino/ \
    && ln -sf libonnxruntime.so.${ORT_OPENVINO_VERSION} /usr/local/lib/ort-openvino/libonnxruntime.so.1 \
    && ln -sf libonnxruntime.so.1 /usr/local/lib/ort-openvino/libonnxruntime.so \
    && rm -rf /tmp/ort-openvino.whl /tmp/ort-openvino-extract \
    && ldconfig

# Node itself — `node:${NODE_VERSION}-slim` is Debian bookworm/glibc underneath (verified), same
# as this `runtime` base, so its binary links cleanly here without reinstalling from scratch.
# `corepack`/`npm`/`npx` are themselves relative *symlinks* into `node_modules` in the source
# image (e.g. `corepack -> ../lib/node_modules/corepack/dist/corepack.js`) — a plain multi-source
# `COPY ... /usr/local/bin/` dereferences symlinks into flat regular files, which breaks their own
# internal `require('./lib/...')` calls (relative to the symlink's real target, not to
# `/usr/local/bin/` where the dereferenced copy actually lands). Copying `node`'s real binary
# first, then `node_modules`, then recreating these three as symlinks matching the exact relative
# paths the upstream image itself uses, avoids that — verified the hard way (this exact failure:
# "Cannot find module './lib/corepack.cjs'").
COPY --from=frontend-deps /usr/local/bin/node /usr/local/bin/
COPY --from=frontend-deps /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Baked-in node_modules for fast, deterministic startup (see this file's own doc comment on why
# this isn't reinstalled at container-run time). `pnpm-workspace.yaml` itself must ship alongside
# them, not just the installed packages — Vite's dev server uses it to detect the monorepo root
# for its own `server.fs.allow` access control; without it (a real, live-confirmed gap — this file
# was never copied into any runtime image layer at all, only ever patched into one specific
# already-running container by hand, which didn't survive that container being recreated), Vite
# falls back to a narrower allowed-root guess that doesn't cover `/workspace/node_modules/.pnpm/`,
# 403ing every asset resolved through there — including, very visibly, Font Awesome's own webfont
# files, which silently degraded every icon in the app to plain underlined text.
COPY pnpm-workspace.yaml /workspace/pnpm-workspace.yaml
COPY --from=frontend-deps /build/node_modules /workspace/node_modules
COPY --from=frontend-deps /build/apps/frontend/node_modules /workspace/apps/frontend/node_modules

COPY plugins /usr/local/share/lanrurugi/plugins

COPY redis.conf /etc/lanrurugi/redis.conf
COPY scripts/docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.dev.sh \
    && mkdir -p /home/koyomi/lanrurugi/content /home/koyomi/lanrurugi/thumb /home/koyomi/lanrurugi/database

ENV LANRURUGI_PLUGINS_DIR=/usr/local/share/lanrurugi/plugins
ENV LANRURUGI_LIBRARY_PATH=/home/koyomi/lanrurugi/content
ENV LANRURUGI_THUMB_DIR=/home/koyomi/lanrurugi/thumb
ENV LANRURUGI_REDIS_URL=redis://127.0.0.1:16379
# Explicit, not left to `ort`'s own default `dlopen("libonnxruntime.so")` system-path search — see
# the ORT-setup comment near this file's CPU/GPU tarball extraction steps for why `lanrurugi-server`
# and `lanrurugi-gpu-worker` each need their own separate build/path (this one's for
# `lanrurugi-recommend`'s CPU-only embedding model; the worker sets its own GPU path explicitly on
# spawn, in `gpu_worker_client.rs`, rather than inheriting this one).
ENV ORT_DYLIB_PATH=/usr/local/lib/ort-cpu/libonnxruntime.so
# `LANRURUGI_HEALTHCHECK_FRONTEND_URL` makes `/health` probe Vite as well as the backend's own
# Redis pools. It is only set for the dev image; the production image serves the frontend from the
# same backend process and intentionally leaves this unset.
ENV LANRURUGI_HEALTHCHECK_FRONTEND_URL=http://127.0.0.1:3000
# No `LANRURUGI_STATIC_DIR` set — this backend never serves the frontend itself in dev mode, Vite
# does (see docker-entrypoint.dev.sh: the backend binds an *internal* port, Vite is the
# container's actual public-facing port, proxying `/api/*` through to the backend).
WORKDIR /workspace
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=30s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/health || exit 1
ENTRYPOINT ["docker-entrypoint.dev.sh"]
