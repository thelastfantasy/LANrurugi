<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent (macOS). install-service.sh fills @PREFIX@ and @DATA@ and installs it as
     ~/Library/LaunchAgents/org.lanrurugi.server.plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.lanrurugi.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "@DATA@/lanrurugi.env"; exec "@PREFIX@/bin/lanrurugi-server" serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@DATA@/log/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>@DATA@/log/launchd.err.log</string>
</dict>
</plist>
