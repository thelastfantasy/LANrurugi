# Data locations for the LANrurugi service. Copy to lanrurugi.env, adjust, and point the service
# definition at it (install-service.sh does both). Everything else — web interface, plugins,
# documentation, bundled libraries, models — is found next to the program itself.
LANRURUGI_LIBRARY_PATH=@DATA@/content
LANRURUGI_THUMB_DIR=@DATA@/thumb
LANRURUGI_TEMP_DIR=@DATA@/temp
LANRURUGI_LOG_DIRECTORY=@DATA@/log
LANRURUGI_REDIS_URL=redis://127.0.0.1:6379
LANRURUGI_BIND=0.0.0.0:3000
