# Copy to .env.local (gitignored) and adjust for your own machine — none of these have a sane
# repo-wide default.

# Comma-separated exact process names (matched via `pgrep -x`) — while any of these processes are
# running, `mise run {build,test,clippy}`'s cargo-in-container tasks step down to fewer CPUs and
# lower scheduling priority, so a foreground app (e.g. a game) keeps priority under contention
# instead of a background compile starving it. See scripts/cargo-container-run.sh for details.
# Example: CARGO_CONTAINER_YIELD_TO=dwproton
CARGO_CONTAINER_YIELD_TO=

# Real download URL + its real expected filename, used by stream.rs's opt-in
# download_one_decodes_a_non_ascii_utf8_content_disposition_filename test to verify
# Content-Disposition non-ASCII filename parsing end-to-end against an actual server. Both unset
# by default — the test is skipped (not failed) when either is missing, since it depends on an
# external server this repo doesn't control.
TEST_REAL_DOWNLOAD_URL=
TEST_REAL_DOWNLOAD_EXPECTED_FILENAME=

# Real archive titles (two same-series, one cross-series) used by embedding.rs's opt-in
# real_model_embeds_and_normalizes test to verify same-series titles embed closer together than
# cross-series ones. Kept out of source (not a synthetic fixture — real copyrighted work titles)
# per the same reasoning as TEST_REAL_DOWNLOAD_URL above. All three unset by default — the test is
# skipped (not failed) when any is missing.
LANRURUGI_TEST_TITLE_SAME_SERIES_A=
LANRURUGI_TEST_TITLE_SAME_SERIES_B=
LANRURUGI_TEST_TITLE_CROSS_SERIES=

# Absolute path to a local JSON fixture file (60+ real archive titles annotated with series_group/
# volume — see lanrurugi-recommend/src/recommend.rs's tests::load_fixture_with_volumes for the
# exact shape) used by that module's fixture_titles_recommend_same_series_first acceptance test
# and by `mise run eval-recommend-model` (crates/lanrurugi-recommend/examples/eval_fixture.rs) to
# quantify a candidate embedding model's series-recognition accuracy before switching production
# to it. Real, copyrighted work titles/author handles don't belong in source — this file lives
# outside the repo entirely (anywhere on disk, e.g. ~/.local/share/lanrurugi-test-fixtures/). Unset
# by default — both the test and the eval tool skip (not fail, for the test; the eval tool exits
# with a usage message) when this is missing.
LANRURUGI_TEST_FIXTURE_SERIES_TITLES_PATH=

# Absolute path to a local JSON fixture file ({"archives": [{"id", "title", "tags"}, ...]]) of real
# archives used by tankoubon_grouping.rs's opt-in tankoubon_grouping_real_data_score_matrix test —
# a debug tool that prints every pairwise is_similar_pair score for a real, problematic set of
# archives (e.g. ones the live grouping suggestions endpoint mis-grouped or missed), so tuning
# SIMILARITY_THRESHOLD/COSPLAYER_BONUS/TOKEN_OVERLAP_WEIGHT can be checked against real numbers
# instead of guessing. Same reasoning as LANRURUGI_TEST_FIXTURE_SERIES_TITLES_PATH above — real
# titles/tags don't belong in source. Unset by default — the test skips (not fails) when missing.
LANRURUGI_TEST_TANKOUBON_GROUPING_FIXTURE_PATH=

# Two real archive titles by the same creator, one with the handle written in a bracketed prefix
# with a trailing underscore (e.g. "[handle_ ] Subtitle") and one with it written plainly (e.g.
# "handle - Subtitle") — used by tankoubon_grouping.rs's opt-in title_tokens_splits_on_underscore
# and group_by_similarity_shared_title_token_* tests to verify the '_' delimiter fix (and the
# token-overlap bonus generally) against the real titles that surfaced the bug, rather than a
# synthetic stand-in. Same reasoning as LANRURUGI_TEST_TITLE_SAME_SERIES_A/_B above. Both unset by
# default — the tests skip (not fail) when either is missing.
LANRURUGI_TEST_TITLE_BRACKETED_HANDLE=
LANRURUGI_TEST_TITLE_PLAIN_HANDLE=

# Paths to two real archive files that are different-language versions of the same work — used by
# lanrurugi-imgcompare's `examples/compare_two.rs` manual verification tool (issue #77) to check
# the page-alignment/sharpness-comparison pipeline against a real cross-language pair, not a
# synthetic fixture. Not read by any automated test (the example panics with a clear message if
# unset — it's a manual dev tool, not CI-gated), so leaving these unset just means the example
# can't be run, nothing breaks.
LANRURUGI_TEST_COMPARE_A=
LANRURUGI_TEST_COMPARE_B=
